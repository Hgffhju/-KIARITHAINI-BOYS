                const pollRes = await fetch(`${BACKEND_URL}/api/mpesa/check-status/${checkoutRequestId}`);
                const pollData = await pollRes.json();

                if (pollData.status === 'COMPLETED') {
                    clearInterval(pollInterval);
                    statusModal.className = "mt-4 p-4 rounded-xl bg-emerald-950/80 border border-emerald-500/50 text-xs";
                    statusModal.innerHTML = `
                        <div class="flex items-center space-x-2 text-emerald-400 font-bold mb-1">
                            <span>✓ Payment Received: ${pollData.receipt}</span>
                        </div>
                        <p class="text-slate-200">Payment of KES ${Number(pollData.amount).toLocaleString()} confirmed. Updated Fee Balance: <strong>KES ${Number(pollData.newBalance).toLocaleString()}</strong></p>
                        <a href="${BACKEND_URL}/api/reports/receipt/${pollData.receipt}" target="_blank" class="mt-3 inline-block bg-emerald-600 hover:bg-emerald-500 text-white font-semibold px-3 py-1.5 rounded transition">
                            Download Official Receipt (PDF) &darr;
                        </a>
                    `;
                    btn.disabled = false;
                    btn.innerHTML = `<span>Send M-Pesa Prompt</span>`;
                } else if (pollData.status === 'FAILED' || attempts > 14) {
                    clearInterval(pollInterval);
                    statusModal.className = "mt-4 p-4 rounded-xl bg-red-950/80 border border-red-500/50 text-xs";
                    statusModal.innerHTML = `<span class="text-red-400 font-bold">Payment timed out or cancelled. Please try again.</span>`;
                    btn.disabled = false;
                    btn.innerHTML = `<span>Send M-Pesa Prompt</span>`;
                }
            } catch (err) {
                console.error("Polling error", err);
            }
        }, 2500);

    } catch (err) {
        alert(err.message);
        btn.disabled = false;
        btn.innerHTML = `<span>Send M-Pesa Prompt</span>`;
    }
}
