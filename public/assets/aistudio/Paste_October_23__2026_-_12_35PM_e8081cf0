// Fetch library materials with optional query filters
app.get('/api/elibrary/resources', async (req, res) => {
    const { subject, level, source } = req.query;

    const filters = {};
    if (level && level !== 'all') filters.formLevel = level;
    if (source && source !== 'all') filters.source = source;
    if (subject && subject !== 'all') filters.subject = { contains: subject, mode: 'insensitive' };

    const materials = await prisma.eBookResource.findMany({
        where: filters,
        orderBy: { createdAt: 'desc' }
    });

    res.json(materials);
});
