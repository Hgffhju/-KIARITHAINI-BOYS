const express = require('express');
const axios = require('axios');
const cors = require('cors');
require('dotenv').config();

const app = express();
app.use(cors({ origin: process.env.FRONTEND_URL || '*' }));
app.use(express.json());

// In-Memory storage for demonstration (In production, replace with PostgreSQL / MongoDB)
const studentsDB = [
    { admNo: "4521", name: "Amos Kiprono", parentPhone: "254700000001", feeBalance: 14500, pocketBalance: 1200 }
];
const otpStore = new Map(); // phone -> { code, expiresAt }

// Helper: Format Kenyan Phone Numbers to 254XXXXXXXXX
function formatKenyanPhone(phone) {
    let clean = phone.replace(/\D/g, '');
    if (clean.startsWith('0')) clean = '254' + clean.slice(1);
    if (clean.startsWith('7') || clean.startsWith('1')) clean = '254' + clean;
    return clean;
}

// -------------------------------------------------------------
// 1. SAFARICOM DARAJA API UTILITIES
// -------------------------------------------------------------

const DARAJA_BASE_URL = process.env.MPESA_ENVIRONMENT === 'production'
    ? 'https://api.safaricom.co.ke'
    : 'https://sandbox.safaricom.co.ke';

// Middleware to obtain Daraja OAuth Token
async function getDarajaToken(req, res, next) {
    try {
        const auth = Buffer.from(`${process.env.MPESA_CONSUMER_KEY}:${process.env.MPESA_CONSUMER_SECRET}`).toString('base64');
        const response = await axios.get(`${DARAJA_BASE_URL}/oauth/v1/generate?grant_type=client_credentials`, {
            headers: { Authorization: `Basic ${auth}` }
        });
        req.darajaToken = response.data.access_token;
        next();
    } catch (error) {
        console.error("Daraja Auth Error:", error.response?.data || error.message);
        return res.status(500).json({ error: "Failed to authenticate with Safaricom." });
    }
}

// -------------------------------------------------------------
// 2. AFRICA'S TALKING SMS SERVICE
// -------------------------------------------------------------

async function sendSMS(toPhone, message) {
    try {
        const payload = new URLSearchParams();
        payload.append('username', process.env.AT_USERNAME);
        payload.append('to', toPhone);
        payload.append('message', message);
        if (process.env.AT_SENDER_ID && process.env.AT_USERNAME !== 'sandbox') {
            payload.append('from', process.env.AT_SENDER_ID);
        }

        const url = process.env.AT_USERNAME === 'sandbox'
            ? 'https://api.sandbox.africastalking.com/version1/messaging'
            : 'https://api.africastalking.com/version1/messaging';

        await axios.post(url, payload.toString(), {
            headers: {
                'apiKey': process.env.AT_API_KEY,
                'Content-Type': 'application/x-www-form-urlencoded',
                'Accept': 'application/json'
            }
        });
    } catch (err) {
        console.error("Africa's Talking SMS Error:", err.response?.data || err.message);
    }
}

// -------------------------------------------------------------
// 3. PARENT PORTAL AUTH (PHONE + SMS OTP)
// -------------------------------------------------------------

// Step 1: Send OTP
app.post('/api/auth/send-otp', async (req, res) => {
    const rawPhone = req.body.phone;
    if (!rawPhone) return res.status(400).json({ error: "Phone number required." });

    const phone = formatKenyanPhone(rawPhone);
    const student = studentsDB.find(s => s.parentPhone === phone);

    if (!student) {
        return res.status(404).json({ error: "Phone number not registered to any student." });
    }

    const code = Math.floor(100000 + Math.random() * 900000).toString();
    const expiresAt = Date.now() + 5 * 60 * 1000; // 5 minutes validity
    otpStore.set(phone, { code, expiresAt });

    const text = `Kiarithaini Boys: Your login code is ${code}. Valid for 5 minutes. Do not share this code.`;
    await sendSMS(phone, text);

    return res.json({ success: true, message: "Code sent via SMS." });
});

// Step 2: Verify OTP & Return Student Data
app.post('/api/auth/verify-otp', (req, res) => {
    const { phone: rawPhone, code } = req.body;
    const phone = formatKenyanPhone(rawPhone);

    const record = otpStore.get(phone);
    if (!record || record.expiresAt < Date.now()) {
        return res.status(400).json({ error: "Code expired or not requested." });
    }

    if (record.code !== code) {
        return res.status(400).json({ error: "Invalid 6-digit code." });
    }

    otpStore.delete(phone); // Clear once used
    const student = studentsDB.find(s => s.parentPhone === phone);

    return res.json({
        success: true,
        token: "sample-jwt-or-session-token",
        student
    });
});

// -------------------------------------------------------------
// 4. M-PESA EXPRESS (STK PUSH)
// -------------------------------------------------------------

app.post('/api/mpesa/stkpush', getDarajaToken, async (req, res) => {
    const { phone: rawPhone, amount, accountReference, purpose } = req.body;

    const phone = formatKenyanPhone(rawPhone);
    const shortcode = process.env.MPESA_SHORTCODE;
    const passkey = process.env.MPESA_PASSKEY;

    // Timestamp: YYYYMMDDHHmmss
    const timestamp = new Date().toISOString().replace(/[^0-9]/g, '').slice(0, 14);
    const password = Buffer.from(`${shortcode}${passkey}${timestamp}`).toString('base64');

    const payload = {
        BusinessShortCode: shortcode,
        Password: password,
        Timestamp: timestamp,
        TransactionType: "CustomerPayBillOnline",
        Amount: Math.round(Number(amount)),
        PartyA: phone,
        PartyB: shortcode,
        PhoneNumber: phone,
        CallBackURL: process.env.MPESA_CALLBACK_URL,
        AccountReference: accountReference || "4521",
        TransactionDesc: purpose || "School Fee Payment"
    };

    try {
        const response = await axios.post(`${DARAJA_BASE_URL}/mpesa/stkpush/v1/processrequest`, payload, {
            headers: { Authorization: `Bearer ${req.darajaToken}` }
        });
        return res.json({ success: true, daraja: response.data });
    } catch (err) {
        console.error("STK Push Failed:", err.response?.data || err.message);
        return res.status(500).json({ error: "STK Push request failed", details: err.response?.data });
    }
});

// STK Push Callback Listener
app.post('/api/mpesa/stk-callback', async (req, res) => {
    const callbackData = req.body.Body?.stkCallback;
    if (!callbackData) return res.sendStatus(400);

    const resultCode = callbackData.ResultCode;
    const resultDesc = callbackData.ResultDesc;

    if (resultCode === 0) {
        // Payment successful: Extract parameters
        const items = callbackData.CallbackMetadata.Item;
        const amount = items.find(i => i.Name === 'Amount')?.Value;
        const receipt = items.find(i => i.Name === 'MpesaReceiptNumber')?.Value;
        const phone = items.find(i => i.Name === 'PhoneNumber')?.Value;

        console.log(`Payment confirmed: ${receipt} | KES ${amount} from ${phone}`);

        // Notify parent via SMS
        await sendSMS(
            phone.toString(),
            `Confirmed: Received KES ${amount} for Kiarithaini Boys High School. Ref: ${receipt}. Thank you.`
        );
    } else {
        console.warn(`Payment failed: ${resultDesc}`);
    }

    res.json({ ResultCode: 0, ResultDesc: "Callback processed" });
});

// -------------------------------------------------------------
// 5. C2B PAYBILL VALIDATION & CONFIRMATION
// (When parents pay manually via M-Pesa SIM tool / Lipa na M-Pesa)
// -------------------------------------------------------------

// Safaricom calls Validation URL before accepting the payment
app.post('/api/mpesa/c2b-validation', (req, res) => {
    const billRefNumber = req.body.BillRefNumber ? req.body.BillRefNumber.trim().toUpperCase() : '';

    // Check if account matches standard fee (e.g., "4521") or pocket money ("PKT4521")
    let adm = billRefNumber;
    if (billRefNumber.startsWith('PKT')) {
        adm = billRefNumber.replace('PKT', '');
    }

    const studentExists = studentsDB.some(s => s.admNo === adm);

    if (!studentExists) {
        // Reject the transaction so the parent's money is not deducted with wrong admission number
        return res.json({
            ResultCode: "C2B00012",
            ResultDesc: "Rejected. Admission number not found in Kiarithaini Boys records."
        });
    }

    // Accept payment
    return res.json({
        ResultCode: 0,
        ResultDesc: "Accepted"
    });
});

// Safaricom calls Confirmation URL once payment succeeds
app.post('/api/mpesa/c2b-confirmation', async (req, res) => {
    const { TransID, TransAmount, BillRefNumber, MSISDN } = req.body;

    console.log(`Manual C2B Payment: ${TransID} | KES ${TransAmount} for ${BillRefNumber}`);

    // Update student balance in DB and send SMS receipt
    await sendSMS(
        MSISDN,
        `Kiarithaini Boys: Received KES ${TransAmount} for Adm No: ${BillRefNumber}. M-Pesa Ref: ${TransID}.`
    );

    return res.json({ ResultCode: 0, ResultDesc: "Confirmation received." });
});

const PORT = process.env.PORT || 5000;
app.listen(PORT, () => console.log(`Kiarithaini Backend running on port ${PORT}`));
