const express = require('express');
const axios = require('axios');
const cors = require('cors');
const helmet = require('helmet');
const rateLimit = require('express-rate-limit');
const { PrismaClient } = require('@prisma/client');
require('dotenv').config();

const prisma = new PrismaClient();
const app = express();

app.use(helmet());
app.use(cors({ origin: process.env.FRONTEND_URL || '*' }));
app.use(express.json());

// 1. RATE LIMITING: Prevent SMS draining attacks on Africa's Talking API
const otpLimiter = rateLimit({
    windowMs: 15 * 60 * 1000, // 15 minutes
    max: 4, // Max 4 OTP requests per IP per 15 minutes
    message: { error: "Too many OTP requests from this connection. Please try again after 15 minutes." }
});

// Helper: Format Kenyan Phone Numbers
function formatKenyanPhone(phone) {
    let clean = phone.replace(/\D/g, '');
    if (clean.startsWith('0')) clean = '254' + clean.slice(1);
    if (clean.startsWith('7') || clean.startsWith('1')) clean = '254' + clean;
    return clean;
}

// -------------------------------------------------------------
// SECURE AUTH: OTP GENERATION WITH DB EXPIRATION & RATE LIMIT
// -------------------------------------------------------------
app.post('/api/auth/send-otp', otpLimiter, async (req, res) => {
    const rawPhone = req.body.phone;
    if (!rawPhone) return res.status(400).json({ error: "Phone number required." });

    const phone = formatKenyanPhone(rawPhone);

    // Verify parent has a student in the school
    const student = await prisma.student.findFirst({ where: { parentPhone: phone } });
    if (!student) {
        return res.status(404).json({ error: "Phone number not associated with any active student." });
    }

    const code = Math.floor(100000 + Math.random() * 900000).toString();
    const expiresAt = new Date(Date.now() + 5 * 60 * 1000); // 5 mins

    // Upsert OTP record
    await prisma.otpVerification.upsert({
        where: { phone },
        update: { code, expiresAt, attempts: 0 },
        create: { phone, code, expiresAt }
    });

    // Send SMS via Africa's Talking
    await sendSMS(phone, `Kiarithaini Boys: Your login code is ${code}. Valid for 5 minutes. Do not share.`);

    return res.json({ success: true, message: "Code sent successfully via SMS." });
});

app.post('/api/auth/verify-otp', async (req, res) => {
    const { phone: rawPhone, code } = req.body;
    const phone = formatKenyanPhone(rawPhone);

    const record = await prisma.otpVerification.findUnique({ where: { phone } });
    if (!record || record.expiresAt < new Date()) {
        return res.status(400).json({ error: "Code expired or not requested." });
    }

    if (record.code !== code) {
        await prisma.otpVerification.update({
            where: { phone },
            data: { attempts: { increment: 1 } }
        });
        return res.status(400).json({ error: "Invalid 6-digit code." });
    }

    // Delete used OTP
    await prisma.otpVerification.delete({ where: { phone } });

    // Fetch student data along with recent grades
    const student = await prisma.student.findFirst({
        where: { parentPhone: phone },
        include: {
            academicRecords: { orderBy: { year: 'desc' }, take: 1 },
            transactions: { orderBy: { createdAt: 'desc' }, take: 5 }
        }
    });

    return res.json({ success: true, student });
});

// -------------------------------------------------------------
// DARAJA WEBHOOK: ATOMIC LEDGER RECONCILIATION
// -------------------------------------------------------------
app.post('/api/mpesa/stk-callback', async (req, res) => {
    const callbackData = req.body.Body?.stkCallback;
    if (!callbackData) return res.sendStatus(400);

    const { ResultCode, ResultDesc, CheckoutRequestID, CallbackMetadata } = callbackData;

    if (ResultCode === 0 && CallbackMetadata) {
        const items = CallbackMetadata.Item;
        const amount = items.find(i => i.Name === 'Amount')?.Value;
        const receipt = items.find(i => i.Name === 'MpesaReceiptNumber')?.Value;
        const phone = items.find(i => i.Name === 'PhoneNumber')?.Value;

        // Atomic DB transaction to prevent balance inconsistencies
        await prisma.$transaction(async (tx) => {
            const pendingTx = await tx.transaction.findUnique({
                where: { checkoutRequestId: CheckoutRequestID }
            });

            if (!pendingTx) {
                console.error(`CheckoutRequestID not found: ${CheckoutRequestID}`);
                return;
            }

            // Update Transaction
            await tx.transaction.update({
                where: { id: pendingTx.id },
                data: {
                    status: 'COMPLETED',
                    mpesaReceipt: receipt,
                    rawCallback: callbackData
                }
            });

            // Adjust Ledger
            if (pendingTx.paymentType === 'POCKET_MONEY') {
                await tx.student.update({
                    where: { admNo: pendingTx.studentAdmNo },
                    data: { pocketBalance: { increment: amount } }
                });
            } else {
                // Tuition fees deduction
                await tx.student.update({
                    where: { admNo: pendingTx.studentAdmNo },
                    data: { feeBalance: { decrement: amount } }
                });
            }
        });

        // Send SMS confirmation to parent
        await sendSMS(
            phone.toString(),
            `Confirmed: Received KES ${amount} for Kiarithaini Boys High School. Receipt: ${receipt}. Student records updated.`
        );
    } else {
        // Mark failed
        await prisma.transaction.updateMany({
            where: { checkoutRequestId: CheckoutRequestID },
            data: { status: 'FAILED', rawCallback: callbackData }
        });
    }

    res.json({ ResultCode: 0, ResultDesc: "Accepted" });
});

// -------------------------------------------------------------
// C2B PAYBILL VALIDATION (Instant lookup against database)
// -------------------------------------------------------------
app.post('/api/mpesa/c2b-validation', async (req, res) => {
    let billRef = (req.body.BillRefNumber || '').trim().toUpperCase();
    if (billRef.startsWith('PKT')) {
        billRef = billRef.replace('PKT', '');
    }

    const student = await prisma.student.findUnique({ where: { admNo: billRef } });

    if (!student) {
        return res.json({
            ResultCode: "C2B00012",
            ResultDesc: "Rejected. Admission number does not exist at Kiarithaini Boys."
        });
    }

    return res.json({ ResultCode: 0, ResultDesc: "Accepted" });
});

// C2B CONFIRMATION: Process manual Lipa na M-Pesa payments
app.post('/api/mpesa/c2b-confirmation', async (req, res) => {
    const { TransID, TransAmount, BillRefNumber, MSISDN } = req.body;
    let cleanRef = BillRefNumber.trim().toUpperCase();
    const isPocket = cleanRef.startsWith('PKT');
    const admNo = isPocket ? cleanRef.replace('PKT', '') : cleanRef;

    const amountNum = parseFloat(TransAmount);

    await prisma.$transaction(async (tx) => {
        // Record transaction
        await tx.transaction.create({
            data: {
                mpesaReceipt: TransID,
                studentAdmNo: admNo,
                amount: amountNum,
                paymentType: isPocket ? 'POCKET_MONEY' : 'TUITION_FEES',
                channel: 'C2B_PAYBILL',
                payerPhone: MSISDN.toString(),
                status: 'COMPLETED',
                rawCallback: req.body
            }
        });

        // Update balance
        if (isPocket) {
            await tx.student.update({
                where: { admNo },
                data: { pocketBalance: { increment: amountNum } }
            });
        } else {
            await tx.student.update({
                where: { admNo },
                data: { feeBalance: { decrement: amountNum } }
            });
        }
    });

    await sendSMS(
        MSISDN.toString(),
        `Kiarithaini Boys: Received KES ${TransAmount} for Adm: ${BillRefNumber}. M-Pesa Ref: ${TransID}. Balance updated.`
    );

    res.json({ ResultCode: 0, ResultDesc: "Success" });
});

