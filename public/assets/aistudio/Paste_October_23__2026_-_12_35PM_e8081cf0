Prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PaymentType {
  TUITION_FEES
  POCKET_MONEY
  UNIFORM_BOARDING
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model Student {
  id             String            @id @default(uuid())
  admNo          String            @unique // e.g. "4521"
  firstName      String
  lastName       String
  formLevel      Int               // 1, 2, 3, or 4
  stream         String            // "East", "West", etc.
  parentPhone    String            // "254700000001"
  parentName     String
  feeBalance     Decimal           @default(0.00) @db.Decimal(10, 2)
  pocketBalance  Decimal           @default(0.00) @db.Decimal(10, 2)
  status         String            @default("ACTIVE") // ACTIVE, SUSPENDED, ALUMNI
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  
  transactions   Transaction[]
  academicRecords AcademicRecord[]

  @@index([parentPhone])
  @@index([admNo])
}

model Transaction {
  id               String        @id @default(uuid())
  mpesaReceipt     String?       @unique // e.g. "QKH897ZX2"
  studentAdmNo     String
  student          Student       @relation(fields: [studentAdmNo], references: [admNo], onDelete: Cascade)
  amount           Decimal       @db.Decimal(10, 2)
  paymentType      PaymentType   @default(TUITION_FEES)
  channel          String        @default("STK_PUSH") // "STK_PUSH" or "C2B_PAYBILL"
  payerPhone       String
  status           PaymentStatus @default(PENDING)
  checkoutRequestId String?      @unique // Used to track Daraja STK requests
  rawCallback      Json?
  createdAt        DateTime      @default(now())

  @@index([studentAdmNo])
  @@index([mpesaReceipt])
}

model AcademicRecord {
  id          String   @id @default(uuid())
  studentAdmNo String
  student     Student  @relation(fields: [studentAdmNo], references: [admNo], onDelete: Cascade)
  term        Int      // 1, 2, or 3
  year        Int      // e.g. 2026
  meanGrade   String   // "B+", "A-", etc.
  rank        Int      // 4
  totalClass  Int      // 48
  conduct     String   // "Exemplary"
  attendance  Int      // Percentage, e.g. 100
  createdAt   DateTime @default(now())

  @@unique([studentAdmNo, term, year])
}

model OtpVerification {
  id        String   @id @default(uuid())
  phone     String   @unique
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}
