const PDFDocument = require('pdfkit');

function generateFeeReceiptPDF(transaction, student, res) {
    const doc = new PDFDocument({ margin: 40, size: 'A4' });

    // Stream PDF directly to client response
    res.setHeader('Content-Type', 'application/pdf');
    res.setHeader('Content-Disposition', `attachment; filename=Receipt_${transaction.mpesaReceipt || 'KBHS'}.pdf`);
    doc.pipe(res);

    // Decorative Outer Border
    doc.rect(20, 20, 555, 800).strokeColor('#134e35').lineWidth(2).stroke();
    doc.rect(24, 24, 547, 792).strokeColor('#d97706').lineWidth(0.5).stroke();

    // School Header
    doc.fontSize(18).font('Helvetica-Bold').fillColor('#134e35').text('KIARITHAINI BOYS HIGH SCHOOL', { align: 'center' });
    doc.fontSize(9).font('Helvetica-Oblique').fillColor('#64748b').text('Motto: Strive to Excel', { align: 'center' });
    doc.fontSize(9).font('Helvetica').fillColor('#334155').text('P.O. Box Kiarithaini, Nyeri County, Kenya | Tel: +254 700 000 000', { align: 'center' });
    doc.moveDown(0.5);

    doc.moveTo(40, 95).lineTo(555, 95).strokeColor('#cbd5e1').lineWidth(1).stroke();
    doc.moveDown(1);

    // Document Title
    doc.fontSize(14).font('Helvetica-Bold').fillColor('#d97706').text('OFFICIAL M-PESA PAYMENT RECEIPT', { align: 'center' });
    doc.moveDown(1.5);

    // Metadata Table
    const dateFormatted = new Date(transaction.createdAt).toLocaleString('en-KE', { timeZone: 'Africa/Nairobi' });

    doc.fontSize(10).font('Helvetica-Bold').fillColor('#0f172a');
    doc.text(`Receipt Number: `, 45, 140, { continued: true }).font('Helvetica').text(transaction.mpesaReceipt || 'N/A');
    doc.font('Helvetica-Bold').text(`Transaction Date: `, 320, 140, { continued: true }).font('Helvetica').text(dateFormatted);

    doc.font('Helvetica-Bold').text(`Student Name: `, 45, 160, { continued: true }).font('Helvetica').text(`${student.firstName} ${student.lastName}`);
    doc.font('Helvetica-Bold').text(`Admission Number: `, 320, 160, { continued: true }).font('Helvetica').text(student.admNo);

    doc.font('Helvetica-Bold').text(`Class Stream: `, 45, 180, { continued: true }).font('Helvetica').text(`Form ${student.formLevel} ${student.stream}`);
    doc.font('Helvetica-Bold').text(`Payer Contact: `, 320, 180, { continued: true }).font('Helvetica').text(transaction.payerPhone);

    doc.moveDown(2);

    // Line items box
    const tableTop = 215;
    doc.rect(40, tableTop, 515, 25).fillColor('#f1f5f9').fill();
    doc.fontSize(9).font('Helvetica-Bold').fillColor('#1e293b');
    doc.text('DESCRIPTION', 50, tableTop + 7);
    doc.text('PAYMENT CHANNEL', 250, tableTop + 7);
    doc.text('AMOUNT (KES)', 440, tableTop + 7, { align: 'right', width: 100 });

    const itemTop = tableTop + 35;
    doc.fontSize(10).font('Helvetica').fillColor('#334155');
    doc.text(transaction.paymentType.replace('_', ' '), 50, itemTop);
    doc.text(transaction.channel, 250, itemTop);
    doc.font('Helvetica-Bold').text(Number(transaction.amount).toLocaleString('en-KE', { minimumFractionDigits: 2 }), 440, itemTop, { align: 'right', width: 100 });

    doc.moveTo(40, itemTop + 25).lineTo(555, itemTop + 25).strokeColor('#e2e8f0').stroke();

    // Summary Balances
    const balanceTop = itemTop + 45;
    doc.fontSize(10).font('Helvetica-Bold').fillColor('#1e293b');
    doc.text('Total Amount Received:', 300, balanceTop);
    doc.text(`KES ${Number(transaction.amount).toLocaleString()}`, 440, balanceTop, { align: 'right', width: 100 });

    doc.text('Remaining School Fee Balance:', 300, balanceTop + 20);
    doc.fillColor('#b45309').text(`KES ${Number(student.feeBalance).toLocaleString()}`, 440, balanceTop + 20, { align: 'right', width: 100 });

    // Stamp & Verification Box
    doc.rect(45, 420, 200, 70).dash(3, { space: 2 }).strokeColor('#94a3b8').stroke();
    doc.undash();
    doc.fontSize(8).font('Helvetica-Bold').fillColor('#64748b').text('OFFICIAL BURSAR STAMP / SIGNATURE', 55, 430);
    doc.fontSize(8).font('Helvetica').text('Kiarithaini Boys Accounts Office', 55, 455);
    doc.text('Verified by Daraja Automated Clearing', 55, 467);

    // KDPA 2019 Legal Disclaimer
    doc.fontSize(7.5).font('Helvetica-Oblique').fillColor('#94a3b8');
    doc.text('This receipt was automatically generated under the Kenya Data Protection Act (2019). The school confirms this payment has been credited to the specified student account.', 40, 750, { align: 'center', width: 515 });

    doc.end();
}

